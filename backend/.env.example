# Never commit a real .env file or any Supabase secret key.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=replace-with-your-database-password
RESIHUB_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# For a deployed website, replace localhost entries with its exact HTTPS domain.
